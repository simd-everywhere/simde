[binaries]
c = ['ccache', 'powerpc64-linux-gnu-gcc-14']
cpp = ['ccache', 'powerpc64-linux-gnu-g++-14']
ar = 'powerpc64-linux-gnu-ar'
strip = 'powerpc64-linux-gnu-strip'
objcopy = 'powerpc64-linux-gnu-objcopy'
ld = 'powerpc64-linux-gnu-ld'
exe_wrapper = ['qemu-ppc64-static', '-cpu', 'power9', '-L', '/usr/powerpc64-linux-gnu/']

[built-in options]
c_args = ['-mcpu=power9', '-Wextra', '-Werror']
cpp_args = ['-mcpu=power9', '-Wextra', '-Werror']

[host_machine]
system = 'linux'
cpu_family = 'ppc64'
cpu = 'ppc64'
endian = 'big'
